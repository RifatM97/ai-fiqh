.venv/
__pycache__/
*.pyc
.DS_Store
# The index itself (chunks.json, embeddings.npy, embeddings.meta.json) is
# committed: CI builds the image from a checkout, and the embeddings cache is
# only trusted when its meta file matches. Only the build checkpoint stays out.
index/embeddings.partial.npz
.ipynb_checkpoints/
.env

# Credentials must never live in the working tree. Keys belong in ~/.ssh.
ssh-key*
*.pem
id_rsa*
id_ed25519*

# Pre-edit snapshots; git history serves this purpose once a file is tracked.
*.bak
